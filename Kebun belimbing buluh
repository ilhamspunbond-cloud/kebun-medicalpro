<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kebun Belimbing Wuluh Medicalpro</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Firebase SDKs -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
        import { getFirestore, collection, addDoc, getDocs, deleteDoc, doc, updateDoc, onSnapshot, query, orderBy, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";
        
        // Expose Firebase to global scope for the app script
        window.firebaseModules = { initializeApp, getFirestore, collection, addDoc, getDocs, deleteDoc, doc, updateDoc, onSnapshot, query, orderBy, serverTimestamp };
    </script>
    <style>
        body { font-family: system-ui, -apple-system, sans-serif; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen pb-20">

    <!-- Header / Navbar -->
    <header class="bg-emerald-700 text-white shadow-md sticky top-0 z-50">
        <div class="max-w-4xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <i class="fa-solid fa-seedling text-2xl"></i>
                <div>
                    <h1 class="font-bold text-lg leading-tight">Medicalpro Kebun</h1>
                    <p class="text-xs text-emerald-200">Belimbing Wuluh Management</p>
                </div>
            </div>
            <div class="flex items-center space-x-3">
                <span id="connection-status" class="inline-block w-3 h-3 rounded-full bg-amber-400" title="Menghubungkan Database..."></span>
                <select id="lang-select" class="bg-emerald-800 text-white text-xs px-2 py-1 rounded border border-emerald-600 focus:outline-none">
                    <option value="id">ID</option>
                    <option value="my">MY</option>
                    <option value="en">EN</option>
                </select>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-4xl mx-auto p-4">

        <!-- Live Weather Widget -->
        <section class="bg-gradient-to-r from-teal-600 to-emerald-600 text-white rounded-2xl p-4 mb-4 shadow-sm flex justify-between items-center">
            <div>
                <p class="text-xs text-teal-100 uppercase tracking-wider font-semibold">Kondisi Kebun (Malaysia)</p>
                <h2 id="weather-desc" class="text-xl font-bold mt-0.5">Memuat Cuaca...</h2>
                <p id="weather-tip" class="text-xs text-teal-50 mt-1">Saran: Menyiapkan pemantauan kebun harian.</p>
            </div>
            <div class="text-right">
                <span id="weather-temp" class="text-3xl font-black">--°C</span>
                <div class="text-xs text-teal-100 mt-0.5"><i class="fa-solid fa-droplet"></i> <span id="weather-humidity">--%</span></div>
            </div>
        </section>

        <!-- TAB 1: WALKIE-TALKIE & CHAT -->
        <div id="tab-chat" class="tab-content active">
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-4 mb-4">
                <h3 class="font-bold text-slate-700 mb-3 flex items-center justify-between">
                    <span><i class="fa-solid fa-walkie-talkie text-emerald-600 mr-2"></i>Walkie-Talkie & Pesan Kebun</span>
                    <span class="text-xs font-normal text-slate-400">Real-time Firebase</span>
                </h3>

                <!-- Chat Messages Feed -->
                <div id="chat-feed" class="h-80 overflow-y-auto bg-slate-50 rounded-xl p-3 mb-3 border border-slate-200 flex flex-col space-y-3">
                    <div class="text-center text-xs text-slate-400 my-auto">Memuat pesan komunikasi...</div>
                </div>

                <!-- Input Controls -->
                <div class="flex items-center space-x-2">
                    <input type="text" id="chat-input" placeholder="Tulis catatan atau instruksi kebun..." class="flex-1 bg-slate-100 border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-emerald-500">
                    
                    <!-- Voice Record Button -->
                    <button id="btn-record" type="button" class="bg-rose-500 hover:bg-rose-600 text-white w-11 h-11 rounded-xl flex items-center justify-center shadow-sm transition active:scale-95" title="Tahan/Klik untuk rekam suara">
                        <i class="fa-solid fa-microphone"></i>
                    </button>

                    <!-- Send Text Button -->
                    <button id="btn-send-chat" type="button" class="bg-emerald-600 hover:bg-emerald-700 text-white w-11 h-11 rounded-xl flex items-center justify-center shadow-sm transition active:scale-95">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </div>
                <div id="recording-status" class="text-xs text-rose-500 font-medium mt-2 hidden text-center animate-pulse">
                    <i class="fa-solid fa-circle-dot mr-1"></i> Sedang merekam suara... (Lepas/Klik lagi untuk berhenti)
                </div>
            </div>
        </div>

        <!-- TAB 2: TUGAS (TASKS) -->
        <div id="tab-tasks" class="tab-content">
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-4 mb-4">
                <h3 class="font-bold text-slate-700 mb-3"><i class="fa-solid fa-list-check text-emerald-600 mr-2"></i>Manajemen Tugas & Panen</h3>
                <form id="task-form" class="space-y-3 mb-4">
                    <input type="text" id="task-title" placeholder="Nama Tugas / Perawatan (Cth: Semprot Pupuk Daun)" required class="w-full bg-slate-100 border border-slate-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-emerald-500">
                    <div class="grid grid-cols-2 gap-2">
                        <input type="date" id="task-date" required class="bg-slate-100 border border-slate-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-emerald-500">
                        <select id="task-priority" class="bg-slate-100 border border-slate-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-emerald-500">
                            <option value="Normal">Prioritas Normal</option>
                            <option value="Penting">Penting / Urgent</option>
                        </select>
                    </div>
                    <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2.5 rounded-xl text-sm transition">Tambah Tugas Baru</button>
                </form>
                <div id="tasks-list" class="space-y-2">
                    <!-- Tasks injected here -->
                </div>
            </div>
        </div>

        <!-- TAB 3: KEUANGAN (FINANCE RM) -->
        <div id="tab-finance" class="tab-content">
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-4 mb-4">
                <h3 class="font-bold text-slate-700 mb-3"><i class="fa-solid fa-wallet text-emerald-600 mr-2"></i>Keuangan Kebun (RM)</h3>
                <div class="grid grid-cols-2 gap-3 mb-4">
                    <div class="bg-emerald-50 border border-emerald-100 p-3 rounded-xl">
                        <p class="text-xs text-emerald-600 font-semibold">Total Pemasukan</p>
                        <p id="total-income" class="text-lg font-bold text-emerald-700">RM 0.00</p>
                    </div>
                    <div class="bg-rose-50 border border-rose-100 p-3 rounded-xl">
                        <p class="text-xs text-rose-600 font-semibold">Total Pengeluaran</p>
                        <p id="total-expense" class="text-lg font-bold text-rose-700">RM 0.00</p>
                    </div>
                </div>
                <form id="finance-form" class="space-y-3 mb-4">
                    <div class="grid grid-cols-2 gap-2">
                        <select id="fin-type" class="bg-slate-100 border border-slate-200 rounded-xl px-3 py-2 text-sm focus:outline-none">
                            <option value="income">Pemasukan (+)</option>
                            <option value="expense">Pengeluaran (-)</option>
                        </select>
                        <input type="number" step="0.01" id="fin-amount" placeholder="Jumlah (RM)" required class="bg-slate-100 border border-slate-200 rounded-xl px-3 py-2 text-sm focus:outline-none">
                    </div>
                    <input type="text" id="fin-desc" placeholder="Keterangan (Cth: Jual Produk / Beli Pupuk)" required class="w-full bg-slate-100 border border-slate-200 rounded-xl px-3 py-2 text-sm focus:outline-none">
                    <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2.5 rounded-xl text-sm transition">Simpan Catatan Keuangan</button>
                </form>
                <div id="finance-list" class="space-y-2 max-h-60 overflow-y-auto">
                    <!-- Finance items -->
                </div>
            </div>
        </div>

        <!-- TAB 4: INVENTARIS & GALERI -->
        <div id="tab-inventory" class="tab-content">
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-4 mb-4">
                <h3 class="font-bold text-slate-700 mb-3"><i class="fa-solid fa-box-archive text-emerald-600 mr-2"></i>Stok & Galeri Produk</h3>
                <form id="inventory-form" class="space-y-3 mb-4">
                    <input type="text" id="inv-item" placeholder="Nama Barang / Produk (Cth: Teh Daun Belimbing)" required class="w-full bg-slate-100 border border-slate-200 rounded-xl px-3 py-2 text-sm focus:outline-none">
                    <div class="grid grid-cols-2 gap-2">
                        <input type="number" id="inv-qty" placeholder="Jumlah Stok" required class="bg-slate-100 border border-slate-200 rounded-xl px-3 py-2 text-sm focus:outline-none">
                        <input type="text" id="inv-unit" placeholder="Satuan (Botol/Pcs/Kg)" required class="bg-slate-100 border border-slate-200 rounded-xl px-3 py-2 text-sm focus:outline-none">
                    </div>
                    <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2.5 rounded-xl text-sm transition">Tambah Stok Barang</button>
                </form>
                <div id="inventory-list" class="space-y-2">
                    <!-- Inventory items -->
                </div>
            </div>
        </div>

    </main>

    <!-- Bottom Navigation Bar -->
    <nav class="fixed bottom-0 left-0 right-0 bg-white border-t border-slate-200 shadow-lg z-50">
        <div class="max-w-4xl mx-auto flex justify-around py-2">
            <button onclick="switchTab('chat')" id="nav-chat" class="flex flex-col items-center text-emerald-600 nav-btn py-1 px-3">
                <i class="fa-solid fa-walkie-talkie text-lg"></i>
                <span class="text-[10px] mt-1 font-medium">Walkie</span>
            </button>
            <button onclick="switchTab('tasks')" id="nav-tasks" class="flex flex-col items-center text-slate-400 nav-btn py-1 px-3">
                <i class="fa-solid fa-list-check text-lg"></i>
                <span class="text-[10px] mt-1 font-medium">Tugas</span>
            </button>
            <button onclick="switchTab('finance')" id="nav-finance" class="flex flex-col items-center text-slate-400 nav-btn py-1 px-3">
                <i class="fa-solid fa-wallet text-lg"></i>
                <span class="text-[10px] mt-1 font-medium">Keuangan</span>
            </button>
            <button onclick="switchTab('inventory')" id="nav-inventory" class="flex flex-col items-center text-slate-400 nav-btn py-1 px-3">
                <i class="fa-solid fa-boxes-stacked text-lg"></i>
                <span class="text-[10px] mt-1 font-medium">Stok</span>
            </button>
        </div>
    </nav>

    <!-- App Logic Script -->
    <script>
        // Tab switching function
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.nav-btn').forEach(el => {
                el.classList.remove('text-emerald-600');
                el.classList.add('text-slate-400');
            });
            document.getElementById('tab-' + tabId).classList.add('active');
            const btn = document.getElementById('nav-' + tabId);
            btn.classList.remove('text-slate-400');
            btn.classList.add('text-emerald-600');
        }

        // Dummy Weather Simulation for Malaysia Farm
        window.addEventListener('DOMContentLoaded', () => {
            document.getElementById('weather-desc').innerText = "Cerah Berawan";
            document.getElementById('weather-temp').innerText = "32°C";
            document.getElementById('weather-humidity').innerText = "78%";
            document.getElementById('weather-tip').innerText = "Saran: Waktu yang baik untuk perawatan kebun dan jemur bahan.";
            
            // Audio recording simulation setup for mobile HTTPS walkie talkie
            let mediaRecorder;
            let audioChunks = [];
            let isRecording = false;

            const btnRecord = document.getElementById('btn-record');
            const recStatus = document.getElementById('recording-status');

            btnRecord.addEventListener('click', async () => {
                if (!isRecording) {
                    try {
                        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                        mediaRecorder = new MediaRecorder(stream);
                        audioChunks = [];

                        mediaRecorder.ondataavailable = event => {
                            audioChunks.push(event.data);
                        };

                        mediaRecorder.onstop = () => {
                            const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                            const audioUrl = URL.createObjectURL(audioBlob);
                            
                            // Render voice note directly into chat feed simulation
                            const feed = document.getElementById('chat-feed');
                            if(feed.innerText.includes("Memuat")) feed.innerHTML = "";
                            
                            const div = document.createElement('div');
                            div.className = "flex flex-col items-start bg-white p-3 rounded-2xl shadow-xs border border-slate-100 max-w-[80%]";
                            div.innerHTML = `
                                <span class="text-xs font-bold text-emerald-700 mb-1"><i class="fa-solid fa-microphone text-rose-500 mr-1"></i> Pesan Suara Walkie-Talkie</span>
                                <audio controls src="${audioUrl}" class="w-full h-8 mb-1"></audio>
                                <span class="text-[9px] text-slate-400">Baru saja</span>
                            `;
                            feed.appendChild(div);
                            feed.scrollTop = feed.scrollHeight;
                        };

                        mediaRecorder.start();
                        isRecording = true;
                        btnRecord.classList.remove('bg-rose-500', 'hover:bg-rose-600');
                        btnRecord.classList.add('bg-slate-800', 'animate-pulse');
                        recStatus.classList.remove('hidden');
                    } catch (err) {
                        alert("Gagal mengakses mikrofon. Pastikan izin browser diizinkan (HTTPS aktif).");
                        console.error(err);
                    }
                } else {
                    mediaRecorder.stop();
                    isRecording = false;
                    btnRecord.classList.remove('bg-slate-800', 'animate-pulse');
                    btnRecord.classList.add('bg-rose-500', 'hover:bg-rose-600');
                    recStatus.classList.add('hidden');
                }
            });

            // Send Text Chat handler
            document.getElementById('btn-send-chat').addEventListener('click', () => {
                const input = document.getElementById('chat-input');
                const val = input.value.trim();
                if(!val) return;

                const feed = document.getElementById('chat-feed');
                if(feed.innerText.includes("Memuat")) feed.innerHTML = "";

                const div = document.createElement('div');
                div.className = "flex flex-col items-start bg-white p-3 rounded-2xl shadow-xs border border-slate-100 max-w-[80%]";
                div.innerHTML = `
                    <span class="text-xs font-bold text-slate-700 mb-0.5">Pengelola Kebun</span>
                    <p class="text-sm text-slate-600">${val}</p>
                    <span class="text-[9px] text-slate-400 mt-1">Baru saja</span>
                `;
                feed.appendChild(div);
                feed.scrollTop = feed.scrollHeight;
                input.value = "";
            });
        });
    </script>
</body>
</html>
